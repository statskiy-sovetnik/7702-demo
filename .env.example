# Мнемоника, из которой выводятся оба аккаунта:
#   addressIndex 0 -> Алиса   (делегатор; апгрейдится по EIP-7702, держит USDC)
#   addressIndex 1 -> делегат (погашает делегацию, платит газ)
# Используйте ОДНОРАЗОВУЮ мнемонику. Файл .env в .gitignore, но не зашифрован.
EOA_SEED_PHRASE=

# RPC mainnet. Публичные эндпоинты жёстко лимитируют — лучше Alchemy/Infura.
MAINNET_RPC_URL=

# WalletConnect project id для RainbowKit, бесплатно на https://cloud.reown.com
WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# ВНИМАНИЕ. vite.config.ts выводит приватный ключ делегата из мнемоники и
# подставляет его в клиентский бандл — иначе кнопка Execute не смогла бы
# подписать транзакцию в браузере. Следствия:
#   * собранный dist/ деплоить НЕЛЬЗЯ — ключ делегата будет в открытом виде;
#   * на делегате держать только газ (~0.02 ETH) и ничего больше.
# Сама мнемоника в бандл не попадает, только производный ключ индекса 1.
# ---------------------------------------------------------------------------
